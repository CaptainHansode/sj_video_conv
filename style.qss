QTabWidget::pane {  /* The tab widget main frame */
    /*border-top: 8px solid #FFFF00;*/
    /*background-color:#55CC00;*/
    padding: 0;  /*tab frame pading*/
    margin: 0;
}

QTabWidget::tab-bar {
    /* background-color:#FF0000; */
    /*left: 5px; move to the right by 5px */
}


/* Style the tab using the tab sub-control. Note that
    it reads QTabBar _not_ QTabWidget */
QTabBar::tab {
    /* border: 3px solid #F0F;*/
    /* border-bottom-color: #C2C7CB; same as the pane color */
    /* font-size: 12pt; */
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    min-width: 110px;
    margin: 0px 4px 0px 0px;
    /* padding: 6px; */
}

QTabBar::tab:selected, QTabBar::tab:hover {
    background-color: rgb(66, 66, 66);
}

QTabBar::tab:selected {
    /* border-color: #0000FF; */
    border-bottom-color: #C2C7CB; /* same as pane color */
}

QTabBar::tab:!selected {
    background-color:rgb(43, 43, 43);
    margin-top: 2px; /* make non-selected tabs look smaller */
}

QLabel {
    background-color:rgba(0, 0, 0, 0);
}

QLabel:disabled {
    color:rgb(118, 118, 118);
}

QLabel#ffmeg_lb {
    background-color:rgb(35, 35, 35);
}

QLabel#info_lb {
    background-color:rgb(35, 35, 35);
}

QListWidget {
    background-color:rgb(35, 35, 35);
    border-radius: 3px;
    border: 0px;
}

QTableWidget {
    border-radius: 3px;
    border: 0px;
    background-color:rgb(35, 35, 35);
}

QHeaderView::section {
    background-color:rgb(43, 43, 43);
    /*border-right: 1px rgb(56, 56, 56);*/
    /*height: 32px;*/
}

QLineEdit {
    background-color:rgb(35, 35, 35);
    border-radius: 3px;
    border: 0px;
}

QLineEdit:disabled {
    background-color:rgb(70, 70, 70);
    color:rgb(118, 118, 118);
}

QComboBox {
    background-color:rgb(35, 35, 35);
    border-radius: 3px;
    border: 0px;
}

QComboBox:disabled {
    background-color:rgb(70, 70, 70);
    color:rgb(118, 118, 118);
}

QSpinBox {
    background-color:rgb(89, 89, 89);
    border-radius: 2px;
    border: 0px;
}

QSpinBox:disabled {
    background-color:rgb(70, 70, 70);
    color:rgb(118, 118, 118);
}

QDoubleSpinBox {
    background-color:rgb(89, 89, 89);
    border-radius: 2px;
    border: 0px;
}

QDoubleSpinBox:disabled {
    background-color:rgb(70, 70, 70);
    color:rgb(118, 118, 118);
}

QCheckBox {
    background-color:rgb(56, 56, 56);
    spacing: 1px;
    border-radius: 6px;
    border: 0px;
}

QCheckBox:disabled {
    /* background-color:rgb(70, 70, 70); */
    color:rgb(118, 118, 118);
}

QCheckBox::indicator:unchecked {
    /*background-color:rgb(102, 102, 102);*/
    image: url("images/checkbox_unchecked.png");
}

QCheckBox::indicator:unchecked:hover {
    /* background-color:rgb(122, 122, 122); */
    image: url("images/checkbox_unchecked_hover.png");
}

QCheckBox::indicator:checked {
    /* background-color:rgb(82, 120, 180);*/
    image: url("images/checkbox_checked.png");
}

QCheckBox::indicator:checked:disabled {
    /* background-color:rgb(82, 120, 180);*/
    image: url("images/checkbox_checked_disabled.png");
}

QPushButton {
    color:rgb(245, 245, 245);
    background-color:rgb(80, 80, 80);
    padding: 3px;
    border-style: solid;
    border: 0px solid gray;
    border-radius: 3px;
}

QPushButton:hover {
    background-color:rgb(100, 100, 100);
}

QPushButton:pressed {
    background-color:rgb(86, 128, 194);
}

QPushButton:disabled {
    background-color:rgb(70, 70, 70);
    color:rgb(118, 118, 118);
}

QToolButton {
    color:rgb(245, 245, 245);
    background-color:rgb(80, 80, 80);
    padding: 0px;
    border-style: solid;
    border: 0px solid gray;
    border-radius: 3px;
}

QToolButton:hover {
    background-color:rgb(100, 100, 100);
}

QToolButton:pressed {
    background-color:rgb(86, 128, 194);
}

QToolButton:disabled {
    background-color:rgb(70, 70, 70);
    color:rgb(118, 118, 118);
}

QScrollBar:vartical {
    border: 0px solid grey;
    background: rgb(0, 0, 0);
    width: 5px;
    margin: 0 0 0 0;
}

QScrollBar::handle:vartical {
    background: rgb(100, 100, 100);
}

QScrollBar:horizontal {
    border: 0px solid grey;
    background-color: rgb(0, 0, 0);
    height: 10px;
    margin: 0px 20px 0 20px;
}

QScrollBar::handle:horizontal {
    background: rgb(80, 80, 80);
    min-width: 20px;
}

QScrollBar::add-line:horizontal {
    border: 0px solid grey;
    background: rgb(80, 80, 80);
    width: 20px;
    subcontrol-position: right;
    subcontrol-origin: margin;
}

QScrollBar::sub-line:horizontal {
    border: 0px solid grey;
    background: rgb(80, 80, 80);
    width: 20px;
    subcontrol-position: left;
    subcontrol-origin: margin;
}

QMenu {
    border: 0px;
}

 QMenu::item{
    background-color: rgb(35, 35, 35);
    color: rgb(255, 255, 255);
 }

 QMenu::item:selected{
    background-color: rgb(86, 128, 194);
    color: rgb(255, 255, 255);
 } 

QMessageBox {
    background-color:rgb(56, 56, 56);
}
