*{
    background-color: rgb(35, 35, 35);
    color: rgb(204, 204, 204);
    font: 8pt;
    font-family: 'Yu Gothic Medium', 'Yu Gothic', 'YuGothic', 'Hiragino Kaku Gothic Pro', 'Meiryo', 'Osaka', 'MS PGothic', 'sans-serif';
    spacing: 6px;
}

QGroupBox {
    color:rgb(245, 245, 245);
    background-color: rgb(56, 56, 56);
    border-style: none;
    border-radius: 0px;
    border-top: 1.3em solid rgb(66, 66, 66);
    /*padding: 6px 12px 12px 12px;*/
}

QGroupBox::title {
    background-color: rgb(66, 66, 66);
    border-top: 4px solid rgb(66, 66, 66);
    /* border-top: 6px solid rgb(66, 66, 66); */
    padding-left: 10px;
    /* padding: 12px 12px 12px 12px; */
}

/* Direct setting */
QGroupBox#mp4_groupBox {
    border-top: 0.5em solid rgb(66, 66, 66);
}

QGroupBox#avi_groupBox  {
    border-top: 0.5em solid rgb(66, 66, 66);
}

QGroupBox#gif_groupBox  {
    border-top: 0.5em solid rgb(66, 66, 66);
}

QGroupBox#png_groupBox  {
    border-top: 0.5em solid rgb(66, 66, 66);
}

QGroupBox#wav_groupBox  {
    border-top: 0.5em solid rgb(66, 66, 66);
}

